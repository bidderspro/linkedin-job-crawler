{
    "name": "linkedin-scraper-electron",
    "version": "1.0.0",
    "description": "LinkedIn Job Scraper built with Electron",
    "author": "LinkedIn Scraper Developer",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "build": "electron-builder",
        "build:portable": "electron-builder --win portable"
    },
    "dependencies": {
        "@sparticuz/chromium": "^133.0.0",
        "csv-parse": "^5.6.0",
        "csv-writer": "^1.6.0",
        "dotenv": "^16.3.1",
        "express": "^5.1.0",
        "puppeteer-core": "^24.6.1"
    },
    "devDependencies": {
        "electron": "^29.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.example.linkedinscraper",
        "productName": "LinkedIn Job Scraper",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!**/.git",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!node_modules/.cache"
        ],
        "win": {
            "target": [
                "portable"
            ]
        },
        "portable": {
            "artifactName": "LinkedInJobScraper.exe"
        },
        "mac": {
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    }
}
