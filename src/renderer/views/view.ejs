<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap">
        <h2 class="mb-2 mb-sm-0 fs-4">
            <span class="d-inline-block text-truncate" style="max-width: 200px;">
                <%= filename %>
            </span>
        </h2>
        <div>
            <a href="/download/<%= filename %>" class="btn btn-success btn-sm mb-1 mb-sm-0">
                <i class="bi bi-download me-1"></i><span class="d-none d-sm-inline">Download</span>
            </a>
            <a href="/" class="btn btn-light btn-sm mb-1 mb-sm-0">
                <i class="bi bi-arrow-left me-1"></i><span class="d-none d-sm-inline">Back</span>
            </a>
        </div>
    </div>
    <div class="card-body p-0 p-sm-3">
        <% if (records && records.length > 0) { %>
            <div class="d-flex justify-content-between align-items-center p-3 flex-wrap">
                <div class="mb-2 mb-md-0">
                    <span class="badge bg-primary rounded-pill">
                        <%= records.length %> records
                    </span>
                </div>
                <div>
                    <input type="text" class="form-control form-control-sm" id="recordSearch" 
                           placeholder="Search records..." onkeyup="filterRecords()">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-sticky-header" id="recordsTable">
                    <thead class="table-dark">
                        <tr>
                            <% 
                            const headers = Object.keys(records[0]);
                            headers.forEach(header => { 
                                const isHiddenOnSmall = header !== 'title' && header !== 'company';
                                const columnClass = isHiddenOnSmall ? 'd-none d-md-table-cell' : '';
                            %>
                                <th class="<%= columnClass %>"><%= header %></th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        const page = parseInt(query.page) || 1;
                        const limit = 10;
                        const startIndex = (page - 1) * limit;
                        const endIndex = Math.min(startIndex + limit, records.length);
                        const totalPages = Math.ceil(records.length / limit);
                        
                        for (let i = startIndex; i < endIndex; i++) {
                            const record = records[i];
                        %>
                            <tr>
                                <% 
                                let j = 0;
                                Object.entries(record).forEach(([key, value]) => { 
                                    const isHiddenOnSmall = j > 1;
                                    const columnClass = isHiddenOnSmall ? 'd-none d-md-table-cell' : '';
                                    j++;
                                %>
                                    <td class="<%= columnClass %>">
                                        <% if (value && value.toString().startsWith('http')) { %>
                                            <a href="<%= value %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Open
                                            </a>
                                        <% } else { %>
                                            <%= value %>
                                        <% } %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
                <div class="modern-pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/view/<%= filename %>?page=1" aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <% 
                        const startPageNum = Math.max(1, page - 1);
                        const endPageNum = Math.min(totalPages, page + 1);
                        
                        if (startPageNum > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="/view/<%= filename %>?page=1">1</a>
                            </li>
                            <% if (startPageNum > 2) { %>
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            <% } %>
                        <% } %>
                        
                        <% for (let i = startPageNum; i <= endPageNum; i++) { %>
                            <li class="page-item <%= page === i ? 'active' : '' %>">
                                <a class="page-link" href="/view/<%= filename %>?page=<%= i %>"><%= i %></a>
                            </li>
                        <% } %>
                        
                        <% if (endPageNum < totalPages) { %>
                            <% if (endPageNum < totalPages - 1) { %>
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            <% } %>
                            <li class="page-item">
                                <a class="page-link" href="/view/<%= filename %>?page=<%= totalPages %>"><%= totalPages %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/view/<%= filename %>?page=<%= page + 1 %>" aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <span class="page-stats">Showing <%= startIndex + 1 %> to <%= endIndex %> of <%= records.length %> entries</span>
                </div>
            <% } %>
        <% } else { %>
            <div class="alert alert-warning m-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>No records found in this file or invalid CSV format.
            </div>
        <% } %>
    </div>
</div>

<script>
    function filterRecords() {
        const input = document.getElementById('recordSearch');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('recordsTable');
        const rows = table.getElementsByTagName('tr');

        for (let i = 1; i < rows.length; i++) {
            const row = rows[i];
            const cells = row.getElementsByTagName('td');
            let shouldShow = false;
            
            for (let j = 0; j < cells.length; j++) {
                const cell = cells[j];
                if (cell) {
                    const textValue = cell.textContent || cell.innerText;
                    if (textValue.toLowerCase().indexOf(filter) > -1) {
                        shouldShow = true;
                        break;
                    }
                }
            }
            
            row.style.display = shouldShow ? '' : 'none';
        }
    }
</script> 