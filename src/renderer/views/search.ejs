<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0 fs-4">New LinkedIn Job Search</h2>
    </div>
    <div class="card-body">
        <% if (error) { %>
            <div class="alert alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
            </div>
        <% } %>
        
        <form method="POST" action="/search">
            <div class="row">
                <div class="col-12 col-md-6 mb-3">
                    <label for="keyword" class="form-label">Job Title / Keywords</label>
                    <input type="text" class="form-control" id="keyword" name="keyword" 
                           placeholder="e.g., Software Engineer, Data Scientist" required>
                    <div class="form-text">Enter job title or keywords to search for</div>
                </div>
                
                <div class="col-12 col-md-6 mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" class="form-control" id="location" name="location" 
                           placeholder="e.g., New York, Remote" required>
                    <div class="form-text">Enter city, state, country or "Remote"</div>
                </div>
            </div>
            
            <div class="mb-4">
                <label for="jobCount" class="form-label">Number of Jobs to Fetch</label>
                <div class="row align-items-center">
                    <div class="col-12 col-sm-6 col-md-4">
                        <input type="number" class="form-control" id="jobCount" name="jobCount" 
                               value="10" min="1" max="100">
                    </div>
                    <div class="col-12 col-sm-6 col-md-8 mt-2 mt-sm-0">
                        <div class="form-text mb-0">Maximum number of job listings to retrieve (approximately)</div>
                    </div>
                </div>
            </div>
            
            <div class="d-flex justify-content-between flex-wrap">
                <a href="/" class="btn btn-secondary mb-2 mb-sm-0">
                    <i class="bi bi-arrow-left me-1"></i><span class="d-none d-sm-inline">Back</span>
                </a>
                <button type="submit" class="btn btn-primary" id="searchBtn">
                    <i class="bi bi-search me-1"></i>Start Search
                    <span class="spinner-border spinner-border-sm d-none" id="searchSpinner" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('form').addEventListener('submit', function() {
        document.getElementById('searchBtn').disabled = true;
        document.getElementById('searchSpinner').classList.remove('d-none');
        document.getElementById('searchBtn').innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Searching...';
    });
</script> 