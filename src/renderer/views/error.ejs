<div class="card shadow">
    <div class="card-header text-white" style="background-color: var(--error-color);">
        <h2 class="mb-0 fs-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Error
        </h2>
    </div>
    <div class="card-body py-4">
        <div class="alert mb-4" style="background-color: rgba(239, 68, 68, 0.1); color: var(--error-color); border: none;">
            <p class="mb-0 py-2"><%= message %></p>
        </div>
        
        <div class="text-center mt-4">
            <a href="/" class="btn btn-outline-danger error-home-btn">
                <i class="bi bi-house-door me-1"></i>Return to Home
            </a>
        </div>
    </div>
</div>

<style>
    .error-home-btn {
        border-color: var(--error-color);
        color: var(--error-color);
        transition: all 0.25s ease;
        padding: 8px 16px;
    }
    
    .error-home-btn:hover {
        background-color: var(--error-color);
        border-color: var(--error-color);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    }
</style> 