<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap">
        <h2 class="mb-0 fs-4 me-2 mb-md-0">Saved Job Searches</h2>
        <a href="/search" class="btn btn-light">
            <i class="bi bi-plus-circle me-1"></i><span class="d-none d-sm-inline">New Search</span>
        </a>
    </div>
    <div class="card-body">
        <% if (files && files.length > 0) { %>
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                <div class="mb-2 mb-md-0">
                    <p class="text-muted mb-0">
                        <small>Showing <%= files.length %> of <%= pagination.totalFiles %> files</small>
                    </p>
                </div>
                <div class="d-flex align-items-center">
                    <div class="me-2">
                        <select class="form-select form-select-sm" id="limitSelect" onchange="changeLimit(this.value)">
                            <option value="5" <%= pagination.limit == 5 ? 'selected' : '' %>>5 per page</option>
                            <option value="10" <%= pagination.limit == 10 ? 'selected' : '' %>>10 per page</option>
                            <option value="25" <%= pagination.limit == 25 ? 'selected' : '' %>>25 per page</option>
                            <option value="50" <%= pagination.limit == 50 ? 'selected' : '' %>>50 per page</option>
                        </select>
                    </div>
                    <div>
                        <input type="text" class="form-control form-control-sm" id="searchFilter" 
                               placeholder="Search..." onkeyup="filterTable()">
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover" id="jobsTable">
                    <thead>
                        <tr>
                            <th>Filename</th>
                            <th class="d-none d-md-table-cell">Size</th>
                            <th class="d-none d-sm-table-cell">Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% files.forEach(file => { %>
                            <tr>
                                <td>
                                    <%= file.name %>
                                    <div class="d-block d-sm-none">
                                        <small class="text-muted"><%= file.date %></small>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell"><%= file.size %></td>
                                <td class="d-none d-sm-table-cell"><%= file.date %></td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/view/<%= file.name %>" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i><span class="d-none d-md-inline ms-1">View</span>
                                        </a>
                                        <a href="/download/<%= file.name %>" class="btn btn-sm btn-success">
                                            <i class="bi bi-download"></i><span class="d-none d-md-inline ms-1">Download</span>
                                        </a>
                                        <a href="/delete/<%= file.name %>" class="btn btn-sm btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete this file?')">
                                            <i class="bi bi-trash"></i><span class="d-none d-md-inline ms-1">Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (pagination.total > 1) { %>
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item <%= pagination.current === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/?page=1&limit=<%= pagination.limit %>" aria-label="First">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item <%= pagination.current === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/?page=<%= pagination.current - 1 %>&limit=<%= pagination.limit %>" aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <% 
                        let startPage = Math.max(1, pagination.current - 2);
                        let endPage = Math.min(pagination.total, pagination.current + 2);
                        
                        if (endPage - startPage < 4 && pagination.total > 4) {
                            if (startPage === 1) {
                                endPage = Math.min(startPage + 4, pagination.total);
                            } else if (endPage === pagination.total) {
                                startPage = Math.max(endPage - 4, 1);
                            }
                        }
                        
                        for (let i = startPage; i <= endPage; i++) { 
                        %>
                            <li class="page-item <%= pagination.current === i ? 'active' : '' %>">
                                <a class="page-link" href="/?page=<%= i %>&limit=<%= pagination.limit %>"><%= i %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= pagination.current === pagination.total ? 'disabled' : '' %>">
                            <a class="page-link" href="/?page=<%= pagination.current + 1 %>&limit=<%= pagination.limit %>" aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item <%= pagination.current === pagination.total ? 'disabled' : '' %>">
                            <a class="page-link" href="/?page=<%= pagination.total %>&limit=<%= pagination.limit %>" aria-label="Last">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        <% } else { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No job search data found. 
                <a href="/search" class="alert-link">Create a new search</a>.
            </div>
        <% } %>
    </div>
</div>

<script>
    function changeLimit(limit) {
        window.location.href = `/?page=1&limit=${limit}`;
    }

    function filterTable() {
        const input = document.getElementById('searchFilter');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('jobsTable');
        const rows = table.getElementsByTagName('tr');

        for (let i = 1; i < rows.length; i++) {
            const firstCol = rows[i].getElementsByTagName('td')[0];
            if (firstCol) {
                const textValue = firstCol.textContent || firstCol.innerText;
                if (textValue.toLowerCase().indexOf(filter) > -1) {
                    rows[i].style.display = '';
                } else {
                    rows[i].style.display = 'none';
                }
            }
        }
    }
</script> 